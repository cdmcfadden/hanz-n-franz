# Source video — too large for GitHub (>100MB)
*.mov
*.mp4
*.MOV

# Iteration artifact (frame thumbnails superseded by Wikipedia images)
web/public/equipment/frames_backup/

# OS / editor noise
.DS_Store
*.swp
*~

# env files (the web/.gitignore already covers .env*, this catches any
# stray copies in subdirs)
.env
.env.*
!.env.example

# Logs
*.log

# Playwright MCP browser profile (holds Google session cookies)
.playwright-profile/

# Playwright MCP captures + config (local to this repo, not for commit)
.playwright-mcp/
.mcp.json

# Ad-hoc screenshots taken during assessment passes
/[0-9][0-9]*-*.png
/[0-9][0-9][a-z]-*.png
